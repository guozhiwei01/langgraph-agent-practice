DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DATABASE_URL=postgresql://postgres@localhost:5432/email_agent

# Gmail API OAuth. Keep the downloaded credential files outside source control.
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
GMAIL_USER_ID=me
GMAIL_LABEL=email-agent

# Fine-grained token limited to one repository with Issues: Read and write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/private-email-support
