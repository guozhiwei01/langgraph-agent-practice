DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DATABASE_URL=postgresql://postgres@localhost:5432/email_agent

# TypeSafe decision classifier. Pin the model so routing behavior changes only
# after an explicit upgrade and regression test.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_MIN_CONFIDENCE=0.7
TYPESAFE_DECISION_THRESHOLD=0.7
TYPESAFE_TIMEOUT_SECONDS=10

# Gmail API OAuth. Keep the downloaded credential files outside source control.
GMAIL_CREDENTIALS_FILE=
GMAIL_TOKEN_FILE=
GMAIL_USER_ID=me
GMAIL_LABEL=email-agent

# Fine-grained token limited to one repository with Issues: Read and write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/private-email-support
